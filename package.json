{
  "name": "machinectl",
  "version": "0.4.0",
  "type": "module",
  "description": "Expose shell, screen, mouse, keyboard, and optional pi RPC control through an authenticated MCP relay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoyfellow/machinectl.git"
  },
  "bugs": {
    "url": "https://github.com/acoyfellow/machinectl/issues"
  },
  "homepage": "https://github.com/acoyfellow/machinectl#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "examples/cloudflare-worker-relay/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "predev": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build"
  },
  "bin": {
    "machinectl": "./dist/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3"
  }
}
