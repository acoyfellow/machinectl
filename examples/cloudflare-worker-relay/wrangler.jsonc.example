{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "machinectl-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],

  // Set this to a hostname you control, then protect it with a Cloudflare
  // Access self-hosted application before connecting a laptop daemon.
  "routes": [
    { "pattern": "machinectl.example.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    // Access Application Audience tag and team issuer for the hostname above.
    "CF_ACCESS_AUD": "replace-with-access-app-audience-tag",
    "CF_ACCESS_ISS": "https://replace-with-your-team.cloudflareaccess.com",
    // Optional for newly created MachineHost objects only: wnam, enam, weur, eeur, apac, oc, afr, me, sam.
    "MACHINECTL_LOCATION_HINT": "enam"
  },

  "durable_objects": {
    "bindings": [
      { "name": "MACHINE_HOST", "class_name": "MachineHost" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MachineHost"] }
  ],

  // Optional. If omitted, the relay runs without persistent audit receipts.
  // Create one with `npx wrangler kv namespace create AUDIT_KV`.
  "kv_namespaces": [
    { "binding": "AUDIT_KV", "id": "replace-with-kv-namespace-id" }
  ]
}
